# Railway Postgres connection string.
# Locally: use the public "proxy" connection string from Railway (Postgres service -> Connect -> Public Network).
# On Railway: set this to ${{Postgres.DATABASE_URL}} as a reference variable so it uses the private network.
DATABASE_URL=postgresql://postgres:password@localhost:5432/studyflow

# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

PORT=3000

# Comma-separated list of allowed frontend origins for CORS.
# Local dev: the Vite dev server. Production: your deployed frontend URL.
FRONTEND_URL=http://localhost:5173

# Schema changes go through src/migrations/ (npm run migration:generate / migration:run).
# Keep this "false" and run migrations explicitly. Only flip to "true" for quick,
# throwaway local experimentation — never in an environment with real data.
DB_SYNCHRONIZE=false

# Set "true" only if your Postgres provider requires SSL (Railway's does not by default).
DB_SSL=false

# --- Email reminders (AWS SES + Lambda + EventBridge Scheduler) ---
# See README.md "Email reminders" section for full setup instructions.

# IAM user credentials scoped to ses:SendEmail / ses:SendRawEmail only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must be a verified SES identity (email or domain).
SES_FROM_EMAIL=studyflow@yourdomain.com

# Shared secret the Lambda sends in the Authorization header when it calls
# POST /internal/reminders/process. Generate with: openssl rand -base64 32
# Leave unset locally if you're not testing the reminder job — the endpoint
# returns 503 rather than crashing the app when it's missing.
REMINDER_JOB_SECRET=
