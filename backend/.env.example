# Railway Postgres connection string.
# Locally: use the public "proxy" connection string from Railway (Postgres service -> Connect -> Public Network).
# On Railway: set this to ${{Postgres.DATABASE_URL}} as a reference variable so it uses the private network.
DATABASE_URL=postgresql://postgres:password@localhost:5432/studyflow

# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

PORT=3000

# Comma-separated list of allowed frontend origins for CORS.
# Local dev: the Vite dev server. Production: your deployed frontend URL.
FRONTEND_URL=http://localhost:5173

# Auto-creates/updates tables from entities. Keep "true" for this project's
# scope; set to "false" once you introduce hand-written TypeORM migrations.
DB_SYNCHRONIZE=true

# Set "true" only if your Postgres provider requires SSL (Railway's does not by default).
DB_SSL=false
